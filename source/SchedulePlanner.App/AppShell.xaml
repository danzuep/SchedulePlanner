<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SchedulePlanner.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:SchedulePlanner.App"
    Title="SchedulePlanner.App">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{DynamicResource Maui.LightThemeSurfaceColor}">
            <Label
                Text="Schedule Planner"
                FontSize="Title"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="16" />
        </Grid>
    </Shell.FlyoutHeader>

    <TabBar>
        <ShellContent
            Title="Scheduler"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="MainPage" />
    </TabBar>

</Shell>
