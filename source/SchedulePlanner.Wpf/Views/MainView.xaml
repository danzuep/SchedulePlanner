<UserControl x:Class="SchedulePlanner.Wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="760" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20" HorizontalAlignment="Stretch">

                <!-- Header -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Scheduler Planner"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Upload an Excel schedule file, process it, and download the updated result."
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14" />
                    </StackPanel>
                </Border>

                <!-- Upload Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Upload Excel file"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Choose the source Excel workbook for the scheduler planner."
                                   Margin="0,4,0,10"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />

                        <DockPanel LastChildFill="True">
                            <Button Content="Browse"
                                    Width="96"
                                    Margin="12,0,0,0"
                                    Command="{Binding BrowseInputWorkbookCommand}"
                                    Background="{StaticResource AccentDarkBrush}" />
                            <TextBox Text="{Binding InputWorkbookPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Upload Excel file path" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Password Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Workbook password"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Enter the workbook password if the Excel file is protected."
                                   Margin="0,4,0,10"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />

                        <Border BorderBrush="{StaticResource FieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <PasswordBox x:Name="PasswordBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 PasswordChanged="PasswordBox_OnPasswordChanged"
                                                 Visibility="Visible"
                                                 ToolTip="Workbook password" />

                                    <TextBox x:Name="PasswordRevealBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Visibility="Collapsed"
                                             Text="{Binding WorkbookPassword, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <ToggleButton x:Name="RevealPasswordToggle"
                                              Grid.Column="1"
                                              Width="44"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Margin="0"
                                              ToolTip="Show or hide password">
                                    <TextBlock Text="👁"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </ToggleButton>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Download Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Download Excel file"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Select where the processed workbook should be saved."
                                   Margin="0,4,0,10"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />

                        <DockPanel LastChildFill="True">
                            <Button Content="Browse"
                                    Width="96"
                                    Margin="12,0,0,0"
                                    Command="{Binding BrowseOutputWorkbookCommand}"
                                    Background="{StaticResource AccentDarkBrush}" />
                            <TextBox Text="{Binding OutputWorkbookPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Download Excel file path" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Action Card -->
                <Border Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <CheckBox Content="Wait for close"
                                  IsChecked="{Binding WaitForClose}"
                                  VerticalAlignment="Center"
                                  Foreground="#374151" />

                        <Button Content="Process Workbook"
                                Command="{Binding ProcessWorkbookCommand}"
                                Width="170"
                                HorizontalAlignment="Right"
                                Background="{StaticResource AccentBrush}"
                                DockPanel.Dock="Right" />
                    </DockPanel>
                </Border>

                <!-- Status Card -->
                <Border Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock Text="Status"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Margin="0,0,12,0"
                                   DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>