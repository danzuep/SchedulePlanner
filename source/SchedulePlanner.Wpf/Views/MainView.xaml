<UserControl x:Class="SchedulePlanner.Wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="760" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24"
                        HorizontalAlignment="Stretch">

                <!-- Header -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Scheduler Planner"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap">
                            <Run Text="Upload an Excel schedule workbook, process it, and view the results." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Download Card -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Export Excel template" />

                        <TextBlock Margin="0,6,0,14"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Select where to save a demo schedule planner configuration template." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputWorkbookPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Download Excel file path"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0" />

                                <Button Grid.Column="1"
                                        Content="Browse"
                                        Command="{Binding BrowseOutputWorkbookCommand}"
                                        Background="{StaticResource AccentDarkBrush}" />
                            </Grid>

                            <Button Grid.Column="1"
                                    Content="Export Template"
                                    Command="{Binding ExportWorkbookCommand}"
                                    IsEnabled="{Binding IsButtonEnabled}"
                                    Width="170"
                                    Height="36"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Background="{StaticResource AccentBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Upload Card -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Import Excel configuration" />

                        <TextBlock Margin="0,6,0,14"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Select an Excel configuration workbook to process." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding InputWorkbookPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Upload Excel file path"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0" />

                                <Button Grid.Column="1"
                                        Content="Browse"
                                        Command="{Binding BrowseInputWorkbookCommand}"
                                        Background="{StaticResource AccentDarkBrush}" />
                            </Grid>

                            <Button Grid.Column="1"
                                    Content="Process Workbook"
                                    Command="{Binding ProcessWorkbookCommand}"
                                    IsEnabled="{Binding IsButtonEnabled}"
                                    Width="170"
                                    Height="36"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Background="{StaticResource AccentBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Card -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Status"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   LineHeight="18" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>