<UserControl x:Class="SchedulePlanner.Wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="{StaticResource AppBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <TabControl BorderThickness="0,1,0,0">
            <TabItem Header="Data">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">

                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Generate Synthetic Data" />
                                    <Border Background="#E0F2FE" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="K-12" FontSize="9" FontWeight="Bold" Foreground="#0284C7" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,14" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                                           Text="Create a realistic school scenario with 1600+ students and multi-stream classes." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DemoInfoText}" Foreground="#4B5563" FontSize="12" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding RunDemoScheduleCommand}" Content="Run Demo Schedule" Width="170" Height="36" Margin="16,0,0,0" Background="{StaticResource AccentBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="System Status" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#4B5563" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Export Excel Template" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding OutputWorkbookPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseOutputWorkbookCommand}" Background="{StaticResource AccentDarkBrush}" Width="80" Height="36" />
                                    <Button Grid.Column="2" Content="Export" Command="{Binding ExportWorkbookAsyncCommand}" Width="120" Height="36" Margin="12,0,0,0" Background="{StaticResource AccentBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Import Excel Configuration" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding InputWorkbookPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseInputWorkbookCommand}" Background="{StaticResource AccentDarkBrush}" Width="80" Height="36" />
                                    <Button Grid.Column="2" Content="Process Workbook" Command="{Binding ProcessWorkbookAsyncCommand}" Width="140" Height="36" Margin="12,0,0,0" Background="{StaticResource AccentBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Schedule">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">

                        <Border Style="{StaticResource CardStyle}"
                                Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding TemporalStatus}" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding JobProgress, StringFormat={}{0:0}%}" 
                                               HorizontalAlignment="Right" 
                                               FontWeight="SemiBold"/>
                                </DockPanel>
                                <ProgressBar Height="12" 
                                             Value="{Binding JobProgress}" 
                                             Maximum="100" 
                                             Foreground="{StaticResource AccentBrush}"
                                             IsIndeterminate="{Binding JobProgress, Converter={StaticResource IsZeroConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Schedule Timeline"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <Border Background="#E2E8F0"
                                            CornerRadius="12"
                                            Padding="6,2"
                                            Margin="12,0,0,0">
                                        <TextBlock Text="Syncfusion Ready"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   Foreground="#0369A1" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Timeline view for teachers, classrooms, and streams. Orchestrated via Temporal for reliable long-running solves."
                                           Foreground="#4B5563"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <Grid Height="180">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Classes" FontSize="12" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,24,0" />
                                        <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Teachers" FontSize="12" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,24,0" />
                                        <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Rooms" FontSize="12" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,24,0" />
                                        <Ellipse Width="10" Height="10" Fill="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Streams" FontSize="12" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Height="1" Background="#E5E7EB" Margin="0,0,0,8" />

                                    <Grid Grid.Row="2">
                                        <TextBlock Text="{Binding ScheduleSummaryText}"
                                                   Foreground="#9CA3AF"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>